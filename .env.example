# ====================================================================
# SMARTCITY 360 — Environment Configuration
# ====================================================================

# -----------------------------
# Server Configuration
# -----------------------------
PORT=5000
NODE_ENV=development

# -----------------------------
# Database: Supabase PostgreSQL (Optional)
# If left blank, SmartCity 360 runs in self-contained demonstration mode
# with in-memory stores and localStorage persistence.
# -----------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------
# AI Engine Configuration
# Supported providers: gemini | openai | anthropic | demo
# -----------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# -----------------------------
# Maps & Geolocation
# Free OpenStreetMap tiles are used by default without requiring an API key.
# -----------------------------
VITE_MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# -----------------------------
# Email Notifications (Optional)
# -----------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@smartcity360.gov
SMTP_PASS=your-app-password
SMTP_FROM="SmartCity 360 Alerts <alerts@smartcity360.gov>"
